VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Root domain the platform is deployed on, e.g. maboutique-saas.com
# Each shop is served at <slug>.<VITE_ROOT_DOMAIN>. Leave empty during local
# development if you don't have a domain yet — the app falls back to
# treating every request as the platform (marketing/signup/admin) unless
# VITE_DEV_SHOP_SLUG or ?boutique=<slug> is set.
VITE_ROOT_DOMAIN=

# Local dev only: preview a specific shop's storefront on localhost without
# real subdomain DNS. Alternative to the ?boutique=<slug> query param.
VITE_DEV_SHOP_SLUG=

# Google Analytics 4. Site-wide page_view tracking on platform + storefront
# pages; leave empty (or unset) to disable GA entirely.
VITE_GA_MEASUREMENT_ID=

# Cloudflare Turnstile site key (public) — bot-friction on api/check-email's
# email-existence check (see TURNSTILE_SECRET_KEY below). Get both from
# dash.cloudflare.com → Turnstile → Add site. Leave both unset to disable
# Turnstile entirely (the widget just doesn't render, server skips
# verification) — the endpoint's own Postgres rate limit still applies.
VITE_TURNSTILE_SITE_KEY=

# --- Server-only (set in Vercel's Environment Variables, never exposed to the
# client bundle — no VITE_ prefix, not read anywhere under src/) ---

# Supabase service role key. Bypasses RLS; used only by api/ functions to
# act on behalf of the platform (billing writes, welcome emails).
SUPABASE_SERVICE_ROLE_KEY=

# Wave Business API (Mobile Money checkout).
WAVE_API_KEY=
WAVE_WEBHOOK_SECRET=

# Resend (transactional/marketing emails sent outside Supabase Auth's own
# mailer, e.g. the onboarding welcome email). Get one at resend.com/api-keys.
RESEND_API_KEY=

# Optional: verifies that api/cron/* is really called by Vercel Cron and not
# a random request. Vercel automatically sends this as a Bearer token when
# it invokes a scheduled function if the env var is set — generate any
# random string and set the same value here and in Vercel.
CRON_SECRET=

# Cloudflare Turnstile secret key — pairs with VITE_TURNSTILE_SITE_KEY above.
TURNSTILE_SECRET_KEY=
