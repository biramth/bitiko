VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Root domain the platform is deployed on, e.g. maboutique-saas.com
# Each shop is served at <slug>.<VITE_ROOT_DOMAIN>. Leave empty during local
# development if you don't have a domain yet — the app falls back to
# treating every request as the platform (marketing/signup/admin) unless
# VITE_DEV_SHOP_SLUG or ?boutique=<slug> is set.
VITE_ROOT_DOMAIN=

# Local dev only: preview a specific shop's storefront on localhost without
# real subdomain DNS. Alternative to the ?boutique=<slug> query param.
VITE_DEV_SHOP_SLUG=

# Google Analytics 4 (storefront only). Site-wide page_view tracking on the
# storefront; leave empty (or unset) to disable GA entirely.
VITE_GA_MEASUREMENT_ID=
